# ─────────────────────────────────────────────────────────────
# OunCatalyst website — environment variables
# Copy to .env.local for local development. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemap, Open Graph and the
# same-origin check on form submissions). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional overrides for the public contact details. When blank, the official values in
# src/lib/site.ts are used (phone, email, Instagram, LinkedIn). YouTube/X are hidden when blank.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_X=

# ── Lead storage backend ─────────────────────────────────────
# "sheets-api"   → Google Sheets API with a service account (recommended)
# "apps-script"  → Google Apps Script web app (alternative)
# "local-file"   → writes to .data/leads.jsonl — development only, refused in production
LEADS_BACKEND=sheets-api

# Google Sheets API (server-side only — never prefix with NEXT_PUBLIC_)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service-account JSON. Keep the \n escapes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: override tab names (defaults shown)
SHEET_TAB_CONSULTATION=Consultation Leads
SHEET_TAB_COLLEGE=College Partnerships
SHEET_TAB_GENERAL=General Enquiries

# Google Apps Script alternative (only if LEADS_BACKEND=apps-script)
APPS_SCRIPT_URL=
APPS_SCRIPT_SHARED_SECRET=

# Rate limiting: max submissions per IP per window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600
